SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"

WHATSAPP_PROVIDER="whatsapp-web"
WHATSAPP_AUTOMATION_ENABLED="false"
WHATSAPP_DRY_RUN="true"
WHATSAPP_ALLOW_REAL_SEND="false"
WHATSAPP_SESSION_PATH=".worker-data/whatsapp-session"
WHATSAPP_MESSAGE_DELAY_MS="5000"
WHATSAPP_MAX_SEND_RETRIES="2"

# Optional PWA Web Push dispatch. Keep disabled/dry-run until VAPID is configured
# and production push sending is explicitly approved.
WEB_PUSH_ENABLED="false"
WEB_PUSH_DRY_RUN="true"
WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""
WEB_PUSH_SUBJECT="mailto:admin@example.com"
