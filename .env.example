# Public Supabase app configuration. These values are safe to expose only when
# they are publishable/anon values from your own Supabase project.
SUPABASE_PROJECT_ID="your-supabase-project-ref"
SUPABASE_URL="your-supabase-url"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

VITE_SUPABASE_PROJECT_ID="your-supabase-project-ref"
VITE_SUPABASE_URL="your-supabase-url"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Server-only. Never expose this through VITE_* variables or browser code.
SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"

# Server-only. Used exclusively by the wastage-verification AI processing
# server function to read the weighing-scale image and call the OpenAI
# Responses API. Never expose through VITE_* variables or browser code.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
OPENAI_TEXT_MODEL=
AI_RECOMMENDATIONS_ENABLED=false
AI_RECOMMENDATIONS_OPENAI_MODEL=
AI_WATCHDOG_AI_ENABLED=false

# Server-side Web Push (VAPID). Public key may be sent to the browser by the
# authenticated settings bootstrap; private key and subject must stay server-only.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com
